# Sparkle polls the appcast; never let a stale copy hide an update.
/appcast.xml
  Cache-Control: no-cache
  Content-Type: application/xml; charset=utf-8

# A released file never changes; a new version gets a new name.
/releases/*
  Cache-Control: public, max-age=31536000, immutable

# The static-assets server doesn't know .delta and sends no Content-Type. Sparkle
# then saves the download without its extension, can't unarchive it, and falls
# back to the full DMG.
/releases/*.delta
  Content-Type: application/octet-stream

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
